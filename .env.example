# BitKoop Miner Configuration Example
# Copy this file to .env and update with your credentials

# Wallet credentials (REQUIRED)
WALLET_NAME=default
HOTKEY_NAME=default

# Network configuration (optional - defaults shown)
NETUID=1
SUBTENSOR_NETWORK=finney
SUBTENSOR_ADDRESS=wss://entrypoint-finney.opentensor.ai:443

# Job processing configuration (optional - defaults shown)
CHECK_STALENESS_HOURS=24
RUN_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=168

# TLS Notary configuration (optional - defaults shown)
TLSNOTARY_MODE=local

# TLS-JS validation service (optional - defaults shown)
TLS_JS_URL=http://tls-js:3001
